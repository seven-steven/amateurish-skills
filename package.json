{
  "name": "amateurish-skills",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run typecheck && npm run test:layout && npm run test:engine && npm run test:server && npm run test:browser",
    "typecheck": "tsc --noEmit",
    "test:layout": "python3 -m unittest discover -s tests -v",
    "test:server": "./wxmp-server/run-tests.sh",
    "test:engine": "node --test skills/publish-to-wxmp/engine/tests/*.test.mjs && python3 -m unittest discover -s skills/publish-to-wxmp/engine/tests -v",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
